# Работает на хостинге с Apache (виртуальный хостинг TimeWeb).
# На nginx-контейнере файл просто игнорируется.

ErrorDocument 404 /404.html

# Админка работает только локально (admin/server.py), наружу её не отдаём.
RedirectMatch 404 ^/admin(/|$)
RedirectMatch 404 ^/(DEPLOY|README)\.md$

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|webm|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
